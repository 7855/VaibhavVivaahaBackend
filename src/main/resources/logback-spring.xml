<?xml version="1.0" encoding="UTF-8"?>
<!-- Same behaviour as log4j2-spring.xml, for the case where Logback wins the classpath:
     one file per day under LOG_DIR, kept LOG_RETENTION_DAYS. -->
<configuration>
  <variable name="LOG_DIR" value="${LOG_DIR:-logs}"/>
  <variable name="KEEP_DAYS" value="${LOG_RETENTION_DAYS:-90}"/>
  <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <appender name="Daily" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/api-%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>${KEEP_DAYS}</maxHistory>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
    <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <root level="info">
    <appender-ref ref="Console"/>
    <appender-ref ref="Daily"/>
  </root>
</configuration>
